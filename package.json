		"flowbite-svelte-icons": "^2.3.0",
		"nostr-signer-connector": "^0.6.0",
		"nostr-tools": "^2.19.2",
		"nostr-typedef": "^0.13.0",
		"qrcode": "^1.5.4",
		"rx-nostr": "^3.6.2",
		"rx-nostr-crypto": "^3.1.3"
	}
